{
  "expo": {
    "name": "SalonCloud",
    "slug": "photo-video-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "photovideomanager",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kawa5188.snapwork",
      "infoPlist": {
        "CFBundleDisplayName": "SalonCloud",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "撮影した写真・動画に位置情報を付加するために使用します。",
        "NSCameraUsageDescription": "SalonCloudで写真や動画を撮影するため、カメラへのアクセスを使用します。",
        "NSMicrophoneUsageDescription": "SalonCloudで音声付き動画を撮影するため、マイクへのアクセスを使用します。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "SalonCloudで写真や動画を撮影するため、カメラへのアクセスを使用します。",
          "microphonePermission": "SalonCloudで音声付き動画を撮影するため、マイクへのアクセスを使用します。",
          "recordAudioAndroid": true
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "SalonCloudで写真や動画を撮影するため、カメラへのアクセスを使用します。",
          "enableMicrophonePermission": true,
          "microphonePermissionText": "SalonCloudで音声付き動画を撮影するため、マイクへのアクセスを使用します。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SalonCloudで投稿する写真や動画を選択するため、写真ライブラリへのアクセスを使用します。",
          "cameraPermission": "SalonCloudで写真や動画を撮影するため、カメラへのアクセスを使用します。",
          "microphonePermission": "SalonCloudで音声付き動画を撮影するため、マイクへのアクセスを使用します。"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "SalonCloudで写真や動画を表示・選択するため、写真ライブラリへのアクセスを使用します。",
          "savePhotosPermission": "SalonCloudの写真や動画を端末へ保存するため、写真ライブラリへの追加を使用します。",
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/SalonCloudLogo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser",
      "expo-sqlite",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "47c51392-875e-48bc-8aae-b8050c25d56a"
      }
    },
    "owner": "kawa5188",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/47c51392-875e-48bc-8aae-b8050c25d56a"
    }
  }
}
